NODE_ENV=development
PORT=4000

# PostgreSQL 17 (local install). Create the database first:  createdb leadforge
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/leadforge

# JWT signing secret (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Frontend origin(s) allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5174

# Redis (docker compose up -d)
REDIS_URL=redis://localhost:6379
